# Dirección pública (G…) de Stellar TESTNET que recibe los aportes de ahorro.
# Debe existir en Testnet y tener trustline al USDC de prueba de Circle.
# Nunca pongas aquí claves secretas (S…): esta variable es pública en el bundle.
NEXT_PUBLIC_STELLAR_TESTNET_RECIPIENT=

# Enlace del formulario de feedback (Google Forms/Tally). Sin él, el botón se oculta.
NEXT_PUBLIC_FEEDBACK_URL=

# PostHog Product Analytics (público: solo project token de ingesta, nunca Personal API Key).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
