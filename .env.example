# Stellar Testnet: dirección G… usada por el flujo legacy/de referencia de aportes USDC.
# Los flujos actuales de /panel/billetera muestran la wallet del usuario para recibir USDC.
NEXT_PUBLIC_STELLAR_TESTNET_RECIPIENT=

# Enlace del formulario de feedback (Google Forms/Tally). Sin él, el botón usa el formulario por defecto.
NEXT_PUBLIC_FEEDBACK_URL=

# Pollar: publishable key pública de la app Testnet para la wallet integrada. Nunca uses una secret key aquí.
NEXT_PUBLIC_POLLAR_PUBLISHABLE_KEY=

# PostHog Product Analytics (público: solo project token de ingesta, nunca Personal API Key).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
