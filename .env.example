# Dirección pública (G…) de Stellar TESTNET que recibe los aportes de ahorro.
# Debe existir en Testnet y tener trustline al USDC de prueba de Circle.
# Nunca pongas aquí claves secretas (S…): esta variable es pública en el bundle.
NEXT_PUBLIC_STELLAR_TESTNET_RECIPIENT=

# Enlace del formulario de feedback (Google Forms/Tally). Sin él, el botón se oculta.
NEXT_PUBLIC_FEEDBACK_URL=

# PostHog Product Analytics (público: solo project token de ingesta, nunca Personal API Key).
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog para consultas privadas del Founder Command Center (solo servidor, nunca NEXT_PUBLIC_).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# Acceso Founder de /admin (solo servidor). Usa una contraseña fuerte y un secreto aleatorio.
ADMIN_FOUNDER_EMAIL=
ADMIN_FOUNDER_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_SESSION_TTL_SECONDS=28800
# Throttling stateless del login Founder (cookie firmada; mitiga fuerza bruta, no sustituye WAF).
ADMIN_LOGIN_MAX_ATTEMPTS=5
ADMIN_LOGIN_LOCK_SECONDS=300
